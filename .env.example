# fixora-orchestrator-agent environment template.
# Copy to .env and fill in real values. Never commit .env itself (gitignored).

HOST=0.0.0.0
PORT=8091

# --- Temporal ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=fixora-orchestrator-task-queue

# --- Downstream orchestrator agents ---
DIAGNOSTIC_ORCHESTRATOR_URL=http://localhost:8092
EXECUTION_ORCHESTRATOR_URL=http://localhost:8093
VALIDATION_ORCHESTRATOR_URL=http://localhost:8094

# --- Fixora API (incident management, evidence store) ---
FIXORA_API_BASE_URL=http://localhost:8080

# --- LLM provider (AI Coordinator / RCA Synthesis / Remediation Planner) ---
LLM_PROVIDER=groq
LLM_API_KEY=REPLACE_WITH_YOUR_API_KEY
LLM_MODEL=openai/gpt-oss-120b
